#!/usr/bin/env python3
"""localsendd - LocalSend v2 backend for the KDE Plasma applet (Python port).

Owns multicast discovery, the HTTPS receive server and sending; the plasmoid only talks to the
newline-delimited JSON control socket in $XDG_RUNTIME_DIR/localsend-applet/control.sock, so this
daemon needs neither D-Bus nor systemd. Wire protocol: https://github.com/localsend/protocol (v2.2).
"""

from __future__ import annotations

